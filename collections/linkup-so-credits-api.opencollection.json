{
  "opencollection": "1.0.0",
  "info": {
    "name": "Linkup Credits API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the remaining credits balance for the account.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linkup.so/v1/credits/balance"
          },
          "docs": "Retrieve the remaining credits balance for the account."
        }
      ]
    }
  ],
  "bundled": true
}